
# =============================================================================
# HegiaStock - HegiaBot
# Archivos y directorios ignorados por Git
# =============================================================================

# Variables de entorno y secretos
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Base de datos vectorial ChromaDB
chroma_db/

# Archivos de trazas de ejecucion
data/trazas.jsonl

# Entornos virtuales
.venv/
venv/
env/

# Bases de datos locales
*.db
*.sqlite
*.sqlite3

# Cache de Python
__pycache__/
*.py[cod]
*$py.class

# Pruebas y cobertura
.pytest_cache/
.coverage
htmlcov/

# Laravel y PHP
web/vendor/
web/node_modules/
web/bootstrap/cache/*.php
web/storage/logs/*.log
web/storage/framework/sessions/*
web/storage/framework/views/*
web/storage/framework/cache/data/*

# Dependencias de Node.js
node_modules/

# Configuraciones locales
.vscode/
.kiro/
.idea/

# Archivos temporales
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db

# Conservar archivos gitignore
!.gitignore
